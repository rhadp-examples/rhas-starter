#!/usr/bin/env bash
set -euo pipefail

# Run caib from the rhas-starter image so a local caib binary is not required.
CONTAINER_TOOL="${CONTAINER_TOOL:-podman}"
CONTAINER_IMAGE="${CONTAINER_IMAGE:-ghcr.io/rhadp-examples/rhas-starter:latest}"
# Podman/Docker pull policy: missing | newer | always | never
CAIB_PULL="${CAIB_PULL:-missing}"

PROJECT_DIR="${PROJECT_DIR:-/projects}"

JMP_CONFIG_HOST="${HOME}/.config/jumpstarter"
JMP_CONFIG_CONTAINER="/home/user/.config/jumpstarter"

CAIB_CONFIG_HOST="${HOME}/.config/caib"
CAIB_CONFIG_CONTAINER="/home/user/.config/caib"

KUBE_CONFIG_HOST="${HOME}/.kube"
KUBE_CONFIG_CONTAINER="/home/user/.kube"

mkdir -p "${CAIB_CONFIG_HOST}"

RUN_ARGS=(
  --rm
  --pull="${CAIB_PULL}"
  --entrypoint caib
  -v "${PWD}:${PROJECT_DIR}:rw"
  -v "${CAIB_CONFIG_HOST}:${CAIB_CONFIG_CONTAINER}:rw"
  -w "${PROJECT_DIR}"
  -e "HOME=/home/user"
  -e "XDG_CONFIG_HOME=/home/user/.config"
  -e "JMP_CLIENT_CONFIG_HOME=${JMP_CONFIG_CONTAINER}"
)

if [[ -t 0 && -t 1 ]]; then
  RUN_ARGS+=(-it)
else
  RUN_ARGS+=(-i)
fi

if [[ -d "${KUBE_CONFIG_HOST}" ]]; then
  RUN_ARGS+=(-v "${KUBE_CONFIG_HOST}:${KUBE_CONFIG_CONTAINER}:ro")
  RUN_ARGS+=(-e "KUBECONFIG=${KUBE_CONFIG_CONTAINER}/config")
fi

# Forward caib / cluster-related env vars when set on the host.
for var in CAIB_SERVER CAIB_TOKEN JUMPSTARTER_NAMESPACE JUMPSTARTER_LOGIN_ENDPOINT; do
  if [[ -n "${!var:-}" ]]; then
    RUN_ARGS+=(-e "${var}=${!var}")
  fi
done

exec "${CONTAINER_TOOL}" run "${RUN_ARGS[@]}" "${CONTAINER_IMAGE}" "$@"
