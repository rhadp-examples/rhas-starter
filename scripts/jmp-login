#!/usr/bin/env bash
set -euo pipefail

if [ "$#" -ne 1 ]; then
  echo "Usage: $(basename "$0") <username>" >&2
  echo "  username: the user to log in as (used to generate the jumpstarter client)" >&2
  exit 1
fi

# get the user name from the command line
USER_NAME=$1

source venv/bin/activate

# prepare the environment
# oc cluster-info -> "Kubernetes control plane is running at https://api.<base>:6443"
CLUSTER_API=$(oc cluster-info | awk '/Kubernetes control plane is running at/{print $NF}')
CLUSTER_BASE=${CLUSTER_API#https://api.}
CLUSTER_BASE=${CLUSTER_BASE#http://api.}
CLUSTER_BASE=${CLUSTER_BASE%%:*}

# generate location for the jumpstarter config
JMP_CONFIG_LOCATION=$HOME/.config/jumpstarter/clients
rm -rf $JMP_CONFIG_LOCATION && mkdir -p $JMP_CONFIG_LOCATION

# generate location for the caib config
CAIB_CONFIG_LOCATION=$HOME/.config/caib
CAIB_CONFIG_FILE=$CAIB_CONFIG_LOCATION/cli.json
rm -rf $CAIB_CONFIG_LOCATION && mkdir -p $CAIB_CONFIG_LOCATION

BUILDER_NAMESPACE=${BUILDER_NAMESPACE:-automotive-dev-operator-system}
if [ -z "${CAIB_SERVER:-}" ]; then
  CAIB_SERVER="https://do-build-api.${BUILDER_NAMESPACE}.apps.${CLUSTER_BASE}"
fi

# prepare the jumpstarter login endpoint
JUMPSTARTER_NAMESPACE=${JUMPSTARTER_NAMESPACE:-auto-jumpstarter}
if [ -z "${JUMPSTARTER_LOGIN_ENDPOINT:-}" ]; then
  JUMPSTARTER_LOGIN_ENDPOINT="https://login.${JUMPSTARTER_NAMESPACE}.apps.${CLUSTER_BASE}"
fi

# CLIENT_NAME normalization for use in jumpstarter/kubernetes
CLIENT_NAME=$(echo "$USER_NAME" | tr '[:upper:]' '[:lower:]' | sed 's/[^a-zA-Z0-9-]/-/g; s/-\+/-/g; s/^-//; s/-$//' | cut -c1-63)
if oc get client "$CLIENT_NAME" -n $JUMPSTARTER_NAMESPACE &>/dev/null; then
  oc delete client "$CLIENT_NAME" -n $JUMPSTARTER_NAMESPACE &>/dev/null || true
fi
JMP_CONFIG_FILE=$JMP_CONFIG_LOCATION/$CLIENT_NAME.yaml
USER_NAMESPACE="$CLIENT_NAME-devspaces"

# create the jumpstarter client config
jmp admin create client $CLIENT_NAME --insecure-tls --unsafe --nointeractive -n $JUMPSTARTER_NAMESPACE --oidc-username keycloak:$USER_NAME &>/dev/null

# login to jumpstarter
jmp login --nointeractive --insecure-tls --unsafe $CLIENT_NAME@$JUMPSTARTER_LOGIN_ENDPOINT

# create the caib client config
#scripts/caib login $CAIB_SERVER
